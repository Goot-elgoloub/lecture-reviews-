<style>
  :root{
    --bg:#0a0e16;
    --bg-alt:#0d1220;
    --card:#121a2b;
    --card2:#0f1524;
    --border:#212b40;
    --border-soft:#1a2336;
    --text:#e7ecf5;
    --text-dim:#93a1bd;
    --text-faint:#5c6a89;
    --accent:#38bdf8;
    --accent-soft:#38bdf822;

    --c-conf:#38bdf8;
    --c-integ:#34d399;
    --c-avail:#fbbf24;
    --c-auth:#a78bfa;
    --c-account:#94a3b8;
    --c-passive:#38bdf8;
    --c-active:#f87171;

    --ok:#34d399;
    --bad:#f87171;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:
      radial-gradient(1200px 600px at 85% -10%, #12203a55, transparent 60%),
      radial-gradient(900px 500px at -10% 20%, #1a123655, transparent 55%),
      var(--bg);
    color:var(--text);
    font-family:'Tajawal', sans-serif;
    line-height:1.75;
  }
  html[dir="ltr"] body{font-family:'Fira Code','Tajawal',sans-serif;}
  code, .mono, .eq, .term-en{
    font-family:'Fira Code', monospace;
    direction:ltr;
    unicode-bidi:isolate;
  }
  a{color:var(--accent);}
  h1,h2,h3,h4{font-weight:800; margin:0 0 .5em;}
  p{margin:0 0 1em; color:var(--text);}
  .container{max-width:1080px; margin:0 auto; padding:0 20px;}

  .lang-toggle{
    position:fixed; top:16px; z-index:200;
    inset-inline-end:16px;
    display:flex; background:#0d1524ee; border:1px solid var(--border);
    border-radius:999px; padding:4px; backdrop-filter:blur(8px);
    box-shadow:0 4px 18px #00000055;
  }
  .lang-toggle button{
    border:none; background:transparent; color:var(--text-dim); font-family:'Fira Code',monospace;
    font-weight:600; font-size:.78rem; padding:7px 14px; border-radius:999px; cursor:pointer; transition:.2s;
  }
  .lang-toggle button.active{background:var(--accent); color:#04121c;}

  .hero{position:relative; padding:70px 0 50px; overflow:hidden; border-bottom:1px solid var(--border-soft);}
  .hero-bg-curve{position:absolute; inset:0; opacity:.3; pointer-events:none;}
  .hero .kicker{
    display:inline-block; font-family:'Fira Code',monospace; font-size:.78rem;
    letter-spacing:.12em; color:var(--accent); background:var(--accent-soft);
    border:1px solid #38bdf844; padding:5px 12px; border-radius:999px; margin-bottom:18px;
  }
  .hero h1{font-size:2.4rem; line-height:1.25; max-width:780px;}
  .hero h1 .glow{color:var(--accent); text-shadow:0 0 30px #38bdf866;}
  .hero p.sub{font-size:1.08rem; color:var(--text-dim); max-width:640px;}
  @media(max-width:640px){ .hero h1{font-size:1.7rem;} .lang-toggle{top:10px;} }

  .nav-wrap{position:sticky; top:0; z-index:50; background:#0a0e16dd; backdrop-filter:blur(10px); border-bottom:1px solid var(--border-soft);}
  .nav-scroll{display:flex; gap:6px; overflow-x:auto; padding:10px 20px; max-width:1080px; margin:0 auto; scrollbar-width:none;}
  .nav-scroll::-webkit-scrollbar{display:none;}
  .nav-scroll a{
    flex:none; white-space:nowrap; font-size:.86rem; font-weight:500;
    color:var(--text-dim); text-decoration:none; padding:8px 14px; border-radius:999px; border:1px solid transparent; transition:.2s;
  }
  .nav-scroll a:hover{color:var(--text); border-color:var(--border);}
  .nav-scroll a.active{color:#04121c; background:var(--accent); font-weight:700;}

  section{padding:56px 0; border-bottom:1px solid var(--border-soft);}
  section:last-of-type{border-bottom:none;}
  .eyebrow{font-family:'Fira Code',monospace; font-size:.75rem; color:var(--accent); letter-spacing:.1em; margin-bottom:8px; display:block;}
  section > .container > h2{font-size:1.7rem; margin-bottom:.25em;}
  section > .container > p.lead{color:var(--text-dim); max-width:720px; margin-bottom:2em; font-size:1.02rem;}

  .grid{display:grid; gap:16px;}
  .grid-2{grid-template-columns:repeat(2,1fr);}
  .grid-3{grid-template-columns:repeat(3,1fr);}
  .grid-4{grid-template-columns:repeat(4,1fr);}
  .grid-5{grid-template-columns:repeat(5,1fr);}
  @media(max-width:860px){ .grid-2,.grid-3,.grid-4,.grid-5{grid-template-columns:1fr;} }

  .card{background:linear-gradient(180deg, var(--card), var(--card2)); border:1px solid var(--border); border-radius:var(--radius); padding:22px 22px;}
  .card h3{font-size:1.12rem; margin-bottom:.4em;}
  .card h3 .num{color:var(--accent); font-family:'Fira Code',monospace; margin-left:6px;}
  .card.tinted{border-color:#38bdf844; background:linear-gradient(180deg,#0f1a2c,#0d1524);}

  .badge{display:inline-flex; align-items:center; gap:6px; font-size:.72rem; font-weight:700; font-family:'Fira Code',monospace; padding:3px 10px; border-radius:999px; letter-spacing:.03em;}
  .b-conf{color:var(--c-conf); background:#38bdf81a; border:1px solid #38bdf855;}
  .b-integ{color:var(--c-integ); background:#34d3991a; border:1px solid #34d39955;}
  .b-avail{color:var(--c-avail); background:#fbbf241a; border:1px solid #fbbf2455;}
  .b-auth{color:var(--c-auth); background:#a78bfa1a; border:1px solid #a78bfa55;}
  .b-account{color:var(--c-account); background:#94a3b81a; border:1px solid #94a3b855;}
  .b-passive{color:var(--c-passive); background:#38bdf81a; border:1px solid #38bdf855;}
  .b-active{color:var(--c-active); background:#f871711a; border:1px solid #f8717155;}

  pre{background:#080b12; border:1px solid var(--border); border-radius:10px; padding:16px 18px; overflow-x:auto; direction:ltr; text-align:left; font-family:'Fira Code',monospace; font-size:.88rem; color:#c9e6ff; margin:12px 0;}
  .line-note{display:flex; gap:10px; align-items:flex-start; padding:8px 0; border-top:1px dashed var(--border-soft);}
  .line-note:first-child{border-top:none;}
  .line-note .ln{font-family:'Fira Code',monospace; font-size:.78rem; color:var(--accent); background:#0d1524; border:1px solid var(--border); border-radius:6px; padding:2px 8px; flex:none; margin-top:2px;}

  table{width:100%; border-collapse:collapse; margin:14px 0; font-size:.95rem;}
  th,td{padding:11px 12px; text-align:start; border-bottom:1px solid var(--border-soft);}
  th{color:var(--accent); font-family:'Fira Code',monospace; font-size:.78rem; letter-spacing:.04em; border-bottom:1px solid var(--border);}
  tr:hover td{background:#ffffff05;}
  td .mono{color:#c9e6ff;}

  .note{border-radius:10px; border:1px solid #fbbf2444; background:#fbbf240d; padding:14px 16px; font-size:.95rem; color:#f3e2b0;}
  .note.good{border-color:#34d39944; background:#34d3990d; color:#bdf3da;}
  .note.info{border-color:#38bdf844; background:#38bdf80d; color:#bfe6fb;}
  .note.warn{border-color:#f8717144; background:#f871710d; color:#fbd7d7;}

  .diagram-block{border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; margin-bottom:22px; background:var(--card);}
  .diagram-head{padding:16px 20px; border-bottom:1px solid var(--border-soft); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;}
  .diagram-head h3{margin:0;}
  .diagram-body{padding:20px;}

  .flow-box{border:1px solid var(--border); background:#0d1524; border-radius:10px; padding:12px 16px; text-align:center; font-weight:700; font-family:'Fira Code',monospace; font-size:.9rem;}
  .flow-arrow{display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:var(--text-faint);}
  .panel-diagram{border:1px solid var(--border-soft); border-radius:10px; padding:16px; background:#080b12; margin-bottom:10px;}
  .panel-label{font-family:'Fira Code',monospace; font-size:.78rem; color:var(--text-faint); margin-top:8px; text-align:center;}

  .level-tabs{display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap;}
  .level-tab{padding:9px 16px; border-radius:10px; border:1px solid var(--border); background:var(--card2); color:var(--text-dim); cursor:pointer; font-family:'Tajawal',sans-serif; font-weight:700; font-size:.9rem;}
  .level-tab.active{background:var(--accent); color:#04121c; border-color:var(--accent);}
  .level-panel{display:none;}
  .level-panel.active{display:block;}
  .quickref-list{list-style:none; padding:0; margin:0; font-family:'Fira Code',monospace; direction:ltr; text-align:left;}
  .quickref-list li{padding:10px 14px; margin-bottom:6px; border-radius:8px; background:#0d1524; border:1px solid var(--border-soft); font-size:.86rem; color:#d7e6f7;}

  .quiz-progress{display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; background:var(--card); border:1px solid var(--border); border-radius:12px; padding:14px 18px; gap:14px; flex-wrap:wrap;}
  .quiz-score{font-family:'Fira Code',monospace; font-weight:600; color:var(--accent); font-size:1.05rem;}
  .quiz-bar{flex:1; min-width:140px; height:8px; border-radius:99px; background:#1a2336; overflow:hidden;}
  .quiz-bar-fill{height:100%; width:0%; background:linear-gradient(90deg,#38bdf8,#34d399); transition:width .3s;}

  .q-card{border:1px solid var(--border); background:var(--card); border-radius:var(--radius); padding:20px 22px; margin-bottom:16px;}
  .q-card .q-meta{display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; gap:10px; flex-wrap:wrap;}
  .q-type-tag{font-family:'Fira Code',monospace; font-size:.7rem; color:var(--text-faint); border:1px solid var(--border); padding:2px 9px; border-radius:999px;}
  .q-prompt{font-weight:700; font-size:1.02rem; margin-bottom:14px;}
  .q-prompt code{background:#0d1524; padding:1px 6px; border-radius:5px; font-size:.9em;}
  .opt-list{display:flex; flex-direction:column; gap:8px;}
  .opt{display:flex; align-items:center; gap:10px; padding:11px 14px; border-radius:10px; border:1px solid var(--border); background:var(--card2); cursor:pointer; transition:.15s; font-size:.95rem;}
  .opt:hover{border-color:#38bdf866;}
  .opt input{accent-color:var(--accent); width:16px; height:16px; flex:none;}
  .opt.correct-flash{border-color:var(--ok); background:#34d3991a;}
  .opt.wrong-flash{border-color:var(--bad); background:#f871711a;}
  .fill-input{width:100%; max-width:320px; background:#0d1524; border:1px solid var(--border); border-radius:9px; padding:11px 14px; color:var(--text); font-family:'Fira Code',monospace; font-size:.95rem; direction:ltr; text-align:left;}
  .fill-input:focus{outline:none; border-color:var(--accent);}
  .check-btn{margin-top:14px; background:var(--accent); color:#04121c; border:none; padding:9px 20px; border-radius:9px; font-weight:700; cursor:pointer; font-family:'Tajawal',sans-serif; font-size:.9rem;}
  .check-btn:disabled{opacity:.5; cursor:default;}
  .check-btn:hover:not(:disabled){filter:brightness(1.1);}
  .q-feedback{margin-top:12px; padding:12px 14px; border-radius:10px; font-size:.9rem; display:none;}
  .q-feedback.show{display:block;}
  .q-feedback.correct{background:#34d3991a; border:1px solid #34d39955; color:#c8f5e2;}
  .q-feedback.incorrect{background:#f871711a; border:1px solid #f8717155; color:#fbd7d7;}
  .final-score{text-align:center; padding:30px 20px; border-radius:var(--radius); border:1px solid var(--accent); background:linear-gradient(180deg,#0f1a2c,#0d1524); margin-top:20px; display:none;}
  .final-score.show{display:block;}
  .final-score .big{font-size:2.4rem; font-weight:800; color:var(--accent); font-family:'Fira Code',monospace;}
  .reset-btn{margin-top:14px; background:transparent; border:1px solid var(--border); color:var(--text); padding:9px 20px; border-radius:9px; cursor:pointer; font-family:'Tajawal',sans-serif; font-weight:700;}

  .timeline{position:relative; padding-inline-start:26px; border-inline-start:2px solid var(--border);}
  .t-item{position:relative; padding-bottom:26px;}
  .t-item:last-child{padding-bottom:0;}
  .t-item::before{content:''; position:absolute; inset-inline-start:-32px; top:4px; width:12px; height:12px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 4px #38bdf822;}
  .t-time{font-family:'Fira Code',monospace; color:var(--accent); font-size:.82rem; margin-bottom:2px;}
  .t-title{font-weight:700; margin-bottom:3px;}

  .tip-item, .mistake-item{display:flex; gap:12px; padding:14px 0; border-top:1px solid var(--border-soft);}
  .tip-item:first-child, .mistake-item:first-child{border-top:none;}
  .tip-icon, .mistake-icon{flex:none; font-size:1.2rem; line-height:1.4;}

  footer{padding:30px 0 60px; text-align:center; color:var(--text-faint); font-size:.85rem;}
</style>
