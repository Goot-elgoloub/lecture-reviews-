            <div style="display:flex; flex-direction:column; align-items:center; gap:8px;">
              <div style="display:flex; align-items:center; gap:20px;"><div class="flow-box">Client</div><div class="flow-arrow">↔</div><div class="flow-box">Server</div></div>
