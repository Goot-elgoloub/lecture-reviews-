  {
    type:'mcq',
    prompt:'أي طريقة من طرق بناء الثقة تعتمد على استخدام سلطة إصدار شهادات (certificate authority) كطرف ثالث موثوق من الطرفين؟',
    promptEn:'Which trust-establishment method relies on using a certificate authority as a mutually trusted third party?',
    options:['الثقة المُثبَتة (Validated)','الثقة التاريخية المباشرة (Direct historical)','الثقة المُتوسَّطة (Mediated)','الثقة المُفوَّضة (Mandated)'],
    optionsEn:['Validated trust','Direct historical trust','Mediated trust','Mandated trust'],
    correct:2,
    explain:'الثقة المُتوسَّطة (Mediated Trust) تتضمّن استخدام طرف ثالث موثوق من الطرفين، مثل سلطات إصدار الشهادات العامة (public-key certificate authorities).',
    explainEn:'Mediated trust involves using a mutually trusted third party, such as public-key certificate authorities.'
  }
];

let userAnswers = new Array(QUIZ.length).fill(null);
let checked = new Array(QUIZ.length).fill(false);
let score = 0;

const TYPE_LABELS = {
  ar: {mcq:'اختيار من متعدد', tf:'صح / خطأ', multi:'اختيار متعدد الإجابات', fill:'إكمال الفراغ'},
  en: {mcq:'Multiple Choice', tf:'True / False', multi:'Multiple Select', fill:'Fill in the Blank'}
};

function renderQuiz(preserveState){
  const c = document.getElementById('quizContainer');
  c.innerHTML = '';
  document.getElementById('scoreTotal').textContent = QUIZ.length;

  QUIZ.forEach((q, qi) => {
    const card = document.createElement('div');
    card.className = 'q-card';
    card.id = 'q-'+qi;

    const typeLabel = TYPE_LABELS[QUIZ_LANG][q.type];
    const prompt = (QUIZ_LANG === 'en' && q.promptEn) ? q.promptEn : q.prompt;
    const options = (QUIZ_LANG === 'en' && q.optionsEn) ? q.optionsEn : q.options;

    let optsHtml = '';
    if(q.type === 'mcq'){
      optsHtml = '<div class="opt-list">' + options.map((opt,oi)=>
        `<label class="opt" id="opt-${qi}-${oi}">
          <input type="radio" name="q${qi}" value="${oi}" onchange="selectAnswer(${qi}, ${oi})">
          <span>${opt}</span>
        </label>`).join('') + '</div>';
    } else if(q.type === 'tf'){
      const trueLabel = QUIZ_LANG === 'en' ? '✅ True' : '✅ صح (True)';
      const falseLabel = QUIZ_LANG === 'en' ? '❌ False' : '❌ خطأ (False)';
      optsHtml = `<div class="opt-list">
        <label class="opt" id="opt-${qi}-1"><input type="radio" name="q${qi}" value="true" onchange="selectAnswer(${qi}, true)"><span>${trueLabel}</span></label>
        <label class="opt" id="opt-${qi}-0"><input type="radio" name="q${qi}" value="false" onchange="selectAnswer(${qi}, false)"><span>${falseLabel}</span></label>
      </div>`;
    } else if(q.type === 'multi'){
      optsHtml = '<div class="opt-list">' + options.map((opt,oi)=>
        `<label class="opt" id="opt-${qi}-${oi}">
          <input type="checkbox" name="q${qi}" value="${oi}" onchange="toggleMulti(${qi}, ${oi})">
          <span>${opt}</span>
        </label>`).join('') + '</div>';
    } else if(q.type === 'fill'){
      const placeholder = QUIZ_LANG === 'en' ? 'Type your answer here…' : 'اكتب إجابتك هنا (English)…';
      optsHtml = `<input type="text" class="fill-input" id="fill-${qi}" placeholder="${placeholder}" oninput="userAnswers[${qi}] = this.value; document.getElementById('checkbtn-${qi}').disabled = !this.value.trim();">`;
    }

    const checkLabel = QUIZ_LANG === 'en' ? 'Check Answer' : 'تحقق من الإجابة';
    const qLabel = QUIZ_LANG === 'en' ? 'Question' : 'سؤال';

    card.innerHTML = `
      <div class="q-meta">
        <span class="q-type-tag">${qLabel} ${qi+1} · ${typeLabel}</span>
      </div>
      <div class="q-prompt">${prompt.replace(/\n/g,'<br>')}</div>
      ${optsHtml}
      <button class="check-btn" id="checkbtn-${qi}" onclick="checkAnswer(${qi})" ${q.type==='fill' ? 'disabled':''}>${checkLabel}</button>
      <div class="q-feedback" id="feedback-${qi}"></div>
    `;
    c.appendChild(card);
  });

  if(!preserveState){
    userAnswers = new Array(QUIZ.length).fill(null);
    checked = new Array(QUIZ.length).fill(false);
    score = 0;
  }
  updateScoreBar();
  document.getElementById('finalScore').classList.remove('show');
}

function selectAnswer(qi, val){ userAnswers[qi] = val; }
function toggleMulti(qi, oi){
  if(!Array.isArray(userAnswers[qi])) userAnswers[qi] = [];
  const idx = userAnswers[qi].indexOf(oi);
  if(idx === -1) userAnswers[qi].push(oi); else userAnswers[qi].splice(idx,1);
}

function checkAnswer(qi){
  if(checked[qi]) return;
  const q = QUIZ[qi];
  let isCorrect = false;
  const fb = document.getElementById('feedback-'+qi);
  const options = (QUIZ_LANG === 'en' && q.optionsEn) ? q.optionsEn : q.options;
  const explain = (QUIZ_LANG === 'en' && q.explainEn) ? q.explainEn : q.explain;

  if(q.type === 'mcq'){
    if(userAnswers[qi] === null){ alert(QUIZ_LANG==='en' ? 'Please choose an answer first' : 'من فضلك اختر إجابة أولًا'); return; }
    isCorrect = Number(userAnswers[qi]) === q.correct;
    for(let i=0;i<options.length;i++){
      const el = document.getElementById(`opt-${qi}-${i}`);
      if(i === q.correct) el.classList.add('correct-flash');
      else if(i === Number(userAnswers[qi])) el.classList.add('wrong-flash');
    }
  } else if(q.type === 'tf'){
    if(userAnswers[qi] === null){ alert(QUIZ_LANG==='en' ? 'Please choose an answer first' : 'من فضلك اختر إجابة أولًا'); return; }
    const chosen = (userAnswers[qi] === true || userAnswers[qi] === 'true');
    isCorrect = chosen === q.correct;
    const correctId = q.correct ? `opt-${qi}-1` : `opt-${qi}-0`;
    const wrongId = q.correct ? `opt-${qi}-0` : `opt-${qi}-1`;
    document.getElementById(correctId).classList.add('correct-flash');
    if(!isCorrect) document.getElementById(wrongId).classList.add('wrong-flash');
  } else if(q.type === 'multi'){
    const chosen = Array.isArray(userAnswers[qi]) ? userAnswers[qi].slice().sort() : [];
    const correctSet = q.correctSet.slice().sort();
    isCorrect = chosen.length === correctSet.length && chosen.every((v,i)=>v===correctSet[i]);
    for(let i=0;i<options.length;i++){
      const el = document.getElementById(`opt-${qi}-${i}`);
      const shouldBeCorrect = q.correctSet.includes(i);
      const wasChosen = chosen.includes(i);
      if(shouldBeCorrect) el.classList.add('correct-flash');
      else if(wasChosen) el.classList.add('wrong-flash');
    }
  } else if(q.type === 'fill'){
    const val = (userAnswers[qi] || '').trim().toLowerCase();
    isCorrect = q.accept.some(a => a.toLowerCase() === val || val.includes(a.toLowerCase()));
    const input = document.getElementById('fill-'+qi);
    input.style.borderColor = isCorrect ? 'var(--ok)' : 'var(--bad)';
  }

  checked[qi] = true;
  if(isCorrect) score++;
  fb.className = 'q-feedback show ' + (isCorrect ? 'correct' : 'incorrect');
  const correctTag = QUIZ_LANG==='en' ? '✅ <b>Correct!</b> ' : '✅ <b>إجابة صحيحة!</b> ';
  const wrongTag = QUIZ_LANG==='en' ? '❌ <b>Not quite.</b> ' : '❌ <b>إجابة غير صحيحة.</b> ';
  fb.innerHTML = (isCorrect ? correctTag : wrongTag) + explain;
  document.getElementById('checkbtn-'+qi).disabled = true;
  document.querySelectorAll(`#q-${qi} input`).forEach(inp => inp.disabled = true);

  updateScoreBar();
  if(checked.every(Boolean)) showFinalScore();
}

function updateScoreBar(){
  document.getElementById('scoreNow').textContent = score;
  const answered = checked.filter(Boolean).length;
  const pct = QUIZ.length ? (answered / QUIZ.length) * 100 : 0;
  document.getElementById('quizBarFill').style.width = pct + '%';
}

function showFinalScore(){
  const el = document.getElementById('finalScore');
  const pct = Math.round((score/QUIZ.length)*100);
  document.getElementById('finalScoreText').textContent = `${score} / ${QUIZ.length} (${pct}%)`;
  let msg = '';
  if(QUIZ_LANG === 'en'){
    if(pct >= 85) msg = 'Excellent! You\'re fully ready for Information & Network Security Concepts. 🎉';
    else if(pct >= 60) msg = 'Good! Review the questions you missed via the “Full Explanation” section.';
    else msg = 'It\'s recommended to revisit the “Full Explanation” and “3 Levels” sections before trying again.';
  } else {
    if(pct >= 85) msg = 'ممتاز! أنت جاهز تمامًا لموضوع Information & Network Security Concepts. 🎉';
    else if(pct >= 60) msg = 'جيد! راجع الأسئلة التي أخطأت فيها من خلال قسم "الشرح الكامل".';
    else msg = 'يُنصح بمراجعة قسم "الشرح الكامل" و"3 مستويات" مرة أخرى قبل إعادة المحاولة.';
  }
  document.getElementById('finalScoreMsg').textContent = msg;
  el.classList.add('show');
}

function resetQuiz(){
  userAnswers = new Array(QUIZ.length).fill(null);
  checked = new Array(QUIZ.length).fill(false);
  score = 0;
  document.getElementById('finalScore').classList.remove('show');
  renderQuiz(true);
  document.getElementById('quiz').scrollIntoView({behavior:'smooth'});
}

renderQuiz(false);
</script>

</body>
</html>
