          </div>
          <div class="panel-diagram">
            <div style="display:flex; align-items:center; justify-content:center; gap:40px;">
              <div class="flow-box">Client</div>
              <div style="display:flex; flex-direction:column; align-items:center;"><span style="font-size:1.2rem;">↗</span><div class="flow-box" style="border-color:#f8717166;">Attacker</div></div>
